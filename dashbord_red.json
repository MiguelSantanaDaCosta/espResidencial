    {
        "id": "split-sensores",
        "type": "function",
        "name": "Extrai Campos",
        "func": "var data = msg.payload;\n\n// Temperatura\nvar temp = { topic: \"temp\", payload: data.temperatura };\nvar hum = { topic: \"hum\", payload: data.umidade };\nvar co2 = { topic: \"co2\", payload: data.co2 };\nvar tvoc = { topic: \"tvoc\", payload: data.tvoc };\nvar aqi = { topic: \"aqi\", payload: data.aqi };\nvar lux = { topic: \"lux\", payload: data.lux };\nvar dist = { topic: \"dist\", payload: data.distancia };\nvar presenca = { topic: \"presenca\", payload: data.presenca };\nvar rfid = { topic: \"rfid\", payload: data.rfid };\n\nreturn [temp, hum, co2, tvoc, aqi, lux, dist, presenca, rfid];",
        "outputs": 9,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 80,
        "wires": [
            ["gauge-temp", "chart-temp"],
            ["gauge-hum", "chart-hum"],
            ["gauge-co2", "chart-co2"],
            ["text-tvoc"],
            ["text-aqi"],
            ["gauge-lux", "chart-lux"],
            ["text-dist"],
            ["text-presenca"],
            ["text-rfid"]
        ]
    },
